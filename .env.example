# Free keys:
#  OpenRouter: https://openrouter.ai/keys
#  Groq:       https://console.groq.com/keys
#  Gemini:     https://aistudio.google.com/apikey
#  Cloudflare: https://dash.cloudflare.com/profile/api-tokens (Workers AI), account id on the Workers AI page
#  NVIDIA NIM: https://build.nvidia.com
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional extras. Cloudflare needs BOTH values; without them the provider is simply skipped.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
# Optional web search for the research step (free tier at https://app.tavily.com). Without it: Wikipedia only.
TAVILY_API_KEY=

# Optional: protect your endpoint (clients send header X-API-Key)
APP_API_KEY=

# ADARSH UI chat: roles|verified|simple, deep|fast. CORS_ORIGINS=* is fine with a token; narrow it if public.
# roles = 11-role council (Architect, research, drafters, Skeptic, Falsifiers, Debater, Judge, Reviewers, Refiner).
CHAT_ENGINE=roles
CHAT_MODE=deep
CORS_ORIGINS=*

# Local daily quota guards: a model is skipped once ~95% of its quota is used, and the
# next model in its chain answers. Counters are saved in USAGE_FILE (resets each UTC day).
OPENROUTER_RPD=50      # shared by ALL :free models. Set 1000 if you bought >= 10 credits
GROQ_RPD=1000          # per model
GROQ_TPD=200000        # per model
GROQ_TPM=8000          # per model; requests that cannot fit are routed elsewhere
GEMINI_RPD=0           # 0 = no local cap. Check Google AI Studio -> rate limits, then set it
USAGE_FILE=.usage.json

# Input guard for pasted answers (flags only, never drops)
GUARD_ENABLED=1
GUARD_THRESHOLD=0.8

# Quota saving (all automatic):
#  - helper roles stop at 80% of a daily quota, the last 20% is kept for the judge/refiner
#  - a model past 60% of its daily quota goes to the back of helper chains (load spread)
#  - unknown daily caps (Gemini, NVIDIA, Cloudflare) are learned from the first daily 429 and kept in USAGE_FILE
#  - quota left < 35%: deep runs as fast; < 15%: no debate, no reviewers (judge still answers)
QUOTA_RESERVE_MARGIN=0.8
QUOTA_BALANCE_AT=0.6
QUOTA_TIGHT=0.35
QUOTA_LOW=0.15
QUOTA_AUTO=1
# Roles engine switches (1 = on, 0 = off)
RESEARCH=1
REVIEW=1
DEBATE=1
RESEARCH_TIMEOUT_S=8
# Optional tuning
PANEL_TIMEOUT_S=240
MIN_PANEL_SUCCESS=2
PANEL_MAX_TOKENS=3000
FALSIFIER_MAX_TOKENS=2500
FINAL_MAX_TOKENS=6000
