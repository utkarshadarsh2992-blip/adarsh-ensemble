<resources>
    <style name="Theme.Adarsh" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- dark ground from the first frame: the system splash, the loading view and the web startup animation share it -->
        <item name="android:windowBackground">@drawable/boot_window</item>
        <item name="android:statusBarColor">@color/adarsh_bg</item>
        <item name="android:navigationBarColor">@color/adarsh_bg</item>
    </style>
    <color name="adarsh_bg">#FAF8F4</color>
    <color name="adarsh_fg">#17161A</color>
    <color name="adarsh_icon_bg">#111111</color>
    <!-- startup animation ground (ui/src/css/boot.css .boot) -->
    <color name="adarsh_boot">#05070B</color>
    <!-- accent of the startup animation (ui/src/css/boot.css, variable bc), shared by the native loading frame -->
    <color name="boot_accent">#49D9FF</color>
</resources>
