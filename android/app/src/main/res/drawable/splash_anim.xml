<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon: the "A" draws its outline, fills and settles. It plays from the very first frame
     of a cold start, before the activity exists, and the web startup animation continues from the same 288dp logo. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="g" android:pivotX="54" android:pivotY="54" android:scaleX="0.82" android:scaleY="0.82">
                <path android:name="fill" android:fillColor="#EDEDED" android:fillAlpha="0" android:fillType="evenOdd"
                    android:pathData="M54,28 L74,80 L65,80 L61,69 L47,69 L43,80 L34,80 Z M54,44 L49.5,60 L58.5,60 Z" />
                <path android:name="edge" android:strokeColor="#49D9FF" android:strokeWidth="1.2"
                    android:strokeLineJoin="round" android:trimPathEnd="0"
                    android:pathData="M54,28 L74,80 L65,80 L61,69 L47,69 L43,80 L34,80 Z M54,44 L49.5,60 L58.5,60 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="edge">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="620" android:valueFrom="0"
                android:valueTo="1" android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:duration="420" android:startOffset="380"
                android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="g">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="900" android:valueFrom="0.82"
                    android:valueTo="1" android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:duration="900" android:valueFrom="0.82"
                    android:valueTo="1" android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
