<resources>
    <!-- Android 12+: the system splash already animates the "A" (drawable/splash_anim) on the dark ground, so the
         app opens with motion from the first frame; the web startup animation continues from the same logo. -->
    <style name="Theme.Adarsh" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/adarsh_boot</item>
        <item name="android:statusBarColor">@color/adarsh_bg</item>
        <item name="android:navigationBarColor">@color/adarsh_bg</item>
        <item name="android:windowSplashScreenBackground">@color/adarsh_boot</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
